{
  "name": "sre-portal-frontend",
  "version": "1.0.8",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "vue-tsc --noEmit && vite build",
    "preview": "vite preview",
    "lint:eslint": "eslint --cache \"src/**/*.{vue,ts}\" --fix",
    "lint:prettier": "prettier --write \"**/*.{js,cjs,json,css,scss,vue,html,md,ts}\"",
    "lint:stylelint": "stylelint --cache \"**/*.{css,scss,vue}\" --fix",
    "lint:all": "npm run lint:eslint && npm run lint:prettier && npm run lint:stylelint",
    "commit": "git-cz",
    "preinstall": "npx only-allow pnpm",
    "prepare": "husky",
    "test": "vitest"
  },
  "dependencies": {
    "@element-plus/icons-vue": "^2.3.1",
    "@stomp/stompjs": "^7.1.0",
    "@vueuse/core": "^12.8.2",
    "@vueuse/integrations": "^12.8.2",
    "animate.css": "^4.1.1",
    "axios": "^1.8.4",
    "crypto-js": "^4.2.0",
    "default-passive-events": "^2.0.0",
    "echarts": "^5.6.0",
    "element-plus": "^2.9.7",
    "highlight.js": "^11.12.0",
    "lodash-es": "^4.17.21",
    "nprogress": "^0.2.0",
    "path-browserify": "^1.0.1",
    "path-to-regexp": "^8.2.0",
    "pinia": "^3.0.1",
    "pinia-plugin-persistedstate": "^4.3.0",
    "qs": "^6.14.0",
    "sortablejs": "^1.15.6",
    "vue": "^3.5.13",
    "vue-i18n": "^11.1.2",
    "vue-router": "^4.5.0",
    "vxe-pc-ui": "^4.9.29",
    "vxe-table": "^4.16.11",
    "xe-utils": "^3.7.0"
  },
  "devDependencies": {
    "@commitlint/cli": "^19.8.0",
    "@commitlint/config-conventional": "^19.8.0",
    "@eslint/js": "^9.23.0",
    "@iconify/utils": "^2.3.0",
    "@types/crypto-js": "^4.2.2",
    "@types/lodash-es": "^4.17.12",
    "@types/node": "^22.13.17",
    "@types/nprogress": "^0.2.3",
    "@types/path-browserify": "^1.0.3",
    "@types/qs": "^6.9.18",
    "@types/sortablejs": "^1.15.8",
    "@typescript-eslint/eslint-plugin": "^8.28.0",
    "@typescript-eslint/parser": "^8.28.0",
    "@vitejs/plugin-vue": "^5.2.3",
    "autoprefixer": "^10.4.21",
    "cz-git": "^1.11.1",
    "eslint": "^9.23.0",
    "eslint-config-prettier": "^10.1.1",
    "eslint-plugin-prettier": "^5.2.3",
    "eslint-plugin-vue": "^10.0.0",
    "globals": "^16.0.0",
    "husky": "^9.1.7",
    "lint-staged": "^15.5.0",
    "mockjs": "^1.1.0",
    "postcss": "^8.5.3",
    "postcss-html": "^1.8.0",
    "postcss-scss": "^4.0.9",
    "prettier": "^3.5.3",
    "sass": "^1.86.0",
    "stylelint": "^16.17.0",
    "stylelint-config-recess-order": "^6.0.0",
    "stylelint-config-standard-scss": "^14.0.0",
    "stylelint-config-standard-vue": "^1.0.0",
    "stylelint-order": "^7.0.0",
    "typescript": "^5.8.2",
    "typescript-eslint": "^8.28.0",
    "unocss": "^66.1.0-beta.12",
    "unplugin-auto-import": "^19.1.2",
    "unplugin-vue-components": "^28.4.1",
    "vite": "^6.2.4",
    "vite-plugin-compression": "^0.5.1",
    "vite-plugin-mock-dev-server": "^1.8.4",
    "vite-plugin-svg-icons": "^2.0.1",
    "vitest": "^3.0.9",
    "vue-eslint-parser": "^10.1.1",
    "vue-tsc": "^2.2.8"
  },
  "config": {
    "commitizen": {
      "path": "node_modules/cz-git"
    }
  },
  "lint-staged": {
    "*.{js,ts,jsx,tsx}": [
      "prettier --write",
      "eslint --fix"
    ],
    "*.vue": [
      "prettier --write",
      "eslint --fix",
      "stylelint --fix"
    ],
    "*.{css,scss}": [
      "prettier --write",
      "stylelint --fix"
    ]
  },
  "engines": {
    "node": ">=20.10.0",
    "pnpm": ">=9.0.0"
  }
}